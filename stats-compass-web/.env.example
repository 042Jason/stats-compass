# Supabase (anon/publishable key만 사용 — 서버 컴포넌트에서 읽기 전용 조회)
NEXT_PUBLIC_SUPABASE_URL=https://vfubxcarvrgoetxemroo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NW0OirS8xTkpGULO9P4qVQ_r2OWWWGl

# 배포 후 사이트 절대 URL (sitemap/OG 용, 선택)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /research 의 질문 임베딩용. 이게 없으면 생애나침반 검색이 동작하지 않습니다.
#
#  · NEXT_PUBLIC_ 접두사를 붙이지 마세요. 붙이면 브라우저 번들에 실려 키가 공개됩니다.
#  · 저장소 루트의 .env 가 아니라 <이 폴더>의 .env.local 에 넣어야 합니다.
#    Next.js 는 자기 프로젝트 루트의 env 파일만 읽습니다.
#  · Vercel 에 올릴 때도 Environment Variables 에 따로 등록해야 합니다.
OPENAI_API_KEY=sk-...

# /research 의 "수치로 보기" 가 KOSIS 공유서비스를 부를 때 씁니다.
# 시드 스크립트(루트 .env)와 같은 키를 써도 됩니다. 여기도 NEXT_PUBLIC_ 금지.
KOSIS_API_KEY=...
